# Скопируйте в .env и правьте под себя.

# HTTP-сервер оркестратора (станция будет ходить сюда по LAN)
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=8730
ASSISTANT_LANGUAGE=ru

# --- ASR ---------------------------------------------------------------
# mlx | groq
ASR_PROVIDER=mlx
ASR_FALLBACK=
ASR_MODEL=mlx-community/whisper-large-v3-turbo
# GROQ_API_KEY=gsk_...

# --- LLM ---------------------------------------------------------------
# ollama | gemini
LLM_PROVIDER=ollama
LLM_FALLBACK=
LLM_MODEL=qwen3.5:4b
OLLAMA_URL=http://127.0.0.1:11434
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- TTS ---------------------------------------------------------------
# piper | google (google появится на этапе облачного fallback)
TTS_PROVIDER=piper
TTS_FALLBACK=
PIPER_VOICE=voices/ru_RU-irina-medium.onnx
# GOOGLE_TTS_VOICE=ru-RU-Wavenet-C

# Короткая память диалога, число реплик
ASSISTANT_HISTORY=6
